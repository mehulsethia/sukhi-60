# Sukhi 60 environment variables.
# Copy to .env.local for local work. In Vercel, set these per environment (Production / Preview / Development).
# Legend: [REQUIRED|OPTIONAL] [SECRET|PUBLIC] — where to get it.
# NEVER put a secret in a NEXT_PUBLIC_* variable. NEXT_PUBLIC_* values are inlined into browser JavaScript.

# --- Supabase -------------------------------------------------------------
# [REQUIRED] [PUBLIC] Supabase Dashboard -> Project Settings -> API -> Project URL (local: `supabase status`)
NEXT_PUBLIC_SUPABASE_URL=
# [REQUIRED] [PUBLIC] Dashboard -> Project Settings -> API Keys -> Publishable key (sb_publishable_...). RLS protects all data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# [REQUIRED] [SECRET] Dashboard -> Project Settings -> API Keys -> Secret key (sb_secret_...). Server only; bypasses RLS.
SUPABASE_SECRET_KEY=
# [OPTIONAL] [SECRET] Local Postgres URL for scripts/psql only (local: `supabase status`). Not used by the deployed app.
SUPABASE_DB_URL=

# --- App ------------------------------------------------------------------
# [REQUIRED] [PUBLIC] Public base URL, no trailing slash (e.g. https://sukhi-60.vercel.app). Used in family invite links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# [REQUIRED] [SECRET] Bearer for /api/worker/tick (>= 32 chars). Generate: openssl rand -hex 32. Same value goes into Supabase Vault (scheduler bootstrap).
WORKER_SECRET=
# [REQUIRED] [SECRET] Pepper for hashing WhatsApp link codes (>= 32 chars). Generate: openssl rand -hex 32. Rotating it invalidates unused codes.
LINK_CODE_PEPPER=
# [OPTIONAL] [PUBLIC] "true" enables the fictional /demo route (no AI, no WhatsApp, no DB writes).
DEMO_MODE_ENABLED=true

# --- Anthropic (AI assistant, evidence description, document extraction) --
# [OPTIONAL] [SECRET] console.anthropic.com -> API Keys. Separate billing from any Claude.ai / Claude Code subscription.
ANTHROPIC_API_KEY=
# [OPTIONAL] [PUBLIC] A current model with tool use + image input, from docs.anthropic.com "Models overview". Example at build time: claude-opus-5-5
ANTHROPIC_MODEL=

# --- Speech: ElevenLabs (preferred when set) or Sarvam ---------------------
# Provider is chosen automatically: ElevenLabs if ELEVENLABS_API_KEY is set, else Sarvam, else voice is hidden.
# [OPTIONAL] [SECRET] elevenlabs.io -> Developers -> API Keys (needs Speech to Text + Text to Speech access)
ELEVENLABS_API_KEY=
# [OPTIONAL] [PUBLIC] Default voice for replies read aloud (any voice in your ElevenLabs "My Voices"). Required for audio replies.
ELEVENLABS_VOICE_ID=
# [OPTIONAL] [PUBLIC] Per-language voices (fall back to ELEVENLABS_VOICE_ID). Pick Indian-accented voices from the Voice Library.
ELEVENLABS_VOICE_ID_HI=
ELEVENLABS_VOICE_ID_MR=
# [OPTIONAL] [PUBLIC] TTS model (default eleven_v4 — supports Hindi and Marathi; eleven_multilingual_v2 does NOT support Marathi)
ELEVENLABS_TTS_MODEL=eleven_v4
# [OPTIONAL] [PUBLIC] STT model (default scribe_v2; auto-detects language, handles code-switching)
ELEVENLABS_STT_MODEL=scribe_v2

# --- Sarvam AI (alternative speech provider) -------------------------------
# [OPTIONAL] [SECRET] dashboard.sarvam.ai -> API keys. Without it, voice is hidden and text works fully.
SARVAM_API_KEY=
# [OPTIONAL] [PUBLIC] Speech-to-text model (default saaras:v4; docs.sarvam.ai "Speech to Text")
SARVAM_ASR_MODEL=saaras:v4
# [OPTIONAL] [PUBLIC] Text-to-speech model (default bulbul:v3; docs.sarvam.ai "Text to Speech")
SARVAM_TTS_MODEL=bulbul:v3
# [OPTIONAL] [PUBLIC] Voice id valid for the TTS model (bulbul:v3 default "shubh")
SARVAM_TTS_SPEAKER=shubh

# --- Meta WhatsApp Cloud API (official) -----------------------------------
# All four of these must be set for WhatsApp to switch on; otherwise the web app runs alone. See WHATSAPP_SETUP.md.
# [OPTIONAL] [SECRET] System user token with whatsapp_business_messaging + whatsapp_business_management
WHATSAPP_ACCESS_TOKEN=
# [OPTIONAL] [PUBLIC] App Dashboard -> WhatsApp -> API Setup -> Phone number ID (digits)
WHATSAPP_PHONE_NUMBER_ID=
# [OPTIONAL] [SECRET] App Dashboard -> App settings -> Basic -> App secret (verifies X-Hub-Signature-256)
WHATSAPP_APP_SECRET=
# [OPTIONAL] [SECRET] Any random string >= 16 chars that you also type into the Meta webhook config. openssl rand -hex 16
WHATSAPP_VERIFY_TOKEN=
# [OPTIONAL] [PUBLIC] Graph API version (default v26.0)
WHATSAPP_GRAPH_VERSION=v26.0
# [OPTIONAL] [PUBLIC] Comma list of templates Meta has APPROVED, e.g. sukhi_checkin_ready. Leave empty until approval.
WHATSAPP_APPROVED_TEMPLATES=
# [OPTIONAL] [PUBLIC] Template language codes approved, e.g. en,hi,mr
WHATSAPP_TEMPLATE_LANGUAGES=en,hi,mr

# Public contact address shown in the site footer (Contact link hidden if unset)
NEXT_PUBLIC_CONTACT_EMAIL=
